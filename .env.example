# Copy to .env. With nothing set, the API runs on the LOCAL backend:
# hashing embeddings, an in-memory index and extractive answers. No accounts needed.

# --- Cloud backend (set both keys to enable it) ---
OPENAI_API_KEY=
PINECONE_API_KEY=
PINECONE_INDEX=chatpdfgio
PINECONE_CLOUD=aws
PINECONE_REGION=us-east-1

# Models (any model your OpenAI account can use)
CHAT_MODEL=gpt-5-mini
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536
TRANSCRIPTION_MODEL=gpt-4o-mini-transcribe

# --- Optional: keep the original files in S3 instead of a local folder ---
S3_BUCKET=
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# --- API ---
CORS_ORIGINS=http://localhost:8501
MAX_UPLOAD_MB=25

# --- Streamlit client ---
API_URL=http://localhost:8000
